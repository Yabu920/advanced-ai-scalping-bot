# MT5 login details are optional if your MT5 terminal is already open and logged in.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Optional: point directly to terminal64.exe, not a desktop shortcut.
# Example: C:\Program Files\MetaTrader 5\terminal64.exe
MT5_PATH=

DEFAULT_SYMBOL=XAUUSDm
DEFAULT_TIMEFRAME=M5
DEFAULT_BARS=300

# Comma-separated broker symbol names. Use broker suffixes like XAUUSDm if needed.
SYMBOLS=XAUUSDm,EURUSDm,GBPUSDm

# Comma-separated timeframe names.
TIMEFRAMES=M1,M5,M15,H1

BARS_PER_TIMEFRAME=500

# Entry timeframes used for possible signal candidates. Stage 4 does not place trades.
SIGNAL_TIMEFRAMES=M1,M5

# Higher timeframes used for directional bias.
BIAS_TIMEFRAMES=M15,H1

# Minimum score needed to mark a setup as trade-eligible later.
MIN_SIGNAL_SCORE=70

# Score needed for alert/watch mode.
WATCHLIST_SCORE=55

ALLOW_MIXED_BIAS=false

# Decision journal is a CSV summary of every signal decision.
DECISION_JOURNAL_PATH=data/logs/decision_journal.csv

# Signal history JSONL stores full structured signal details.
SIGNAL_HISTORY_PATH=data/logs/signal_history.jsonl

# This stage only records decisions. It does not trade.
TRACK_WATCHLIST_SIGNALS=true
TRACK_REJECTED_SIGNALS=true

# How many future candles to inspect for post-signal outcome tracking.
OUTCOME_LOOKAHEAD_CANDLES=12

# Favorable move threshold in ATR multiples. Analysis only, not trading.
OUTCOME_MIN_MOVE_ATR=1.0

# Adverse move threshold in ATR multiples. Analysis only, not trading.
OUTCOME_ADVERSE_MOVE_ATR=0.7

OUTCOME_MAX_EVENTS_TO_CHECK=200
OUTCOME_REPORT_PATH=data/logs/signal_outcome_report.csv

# Default risk per generated plan. Stage 7 does not place trades.
RISK_PER_TRADE_PERCENT=0.5

# Safety cap for risk per plan.
MAX_RISK_PER_TRADE_PERCENT=1.0

DEFAULT_RR_RATIO=2.0
MIN_RR_RATIO=1.5
ATR_SL_MULTIPLIER=1.2
ATR_TP_MULTIPLIER=2.0
USE_FIXED_RISK_AMOUNT=false
FIXED_RISK_AMOUNT=5.0
MIN_STOP_ATR_MULTIPLIER=0.8
MAX_STOP_ATR_MULTIPLIER=3.0

# Broker/cost validation only. Stage 8 still does not place trades.
# Spread thresholds are broker-dependent and will be tuned later.
MAX_SPREAD_TO_ATR_RATIO=0.25
MAX_SPREAD_COST_RISK_PERCENT=20.0
MAX_SPREAD_TO_SL_RATIO=0.35
MAX_SPREAD_TO_TP_RATIO=0.25
MIN_NET_RR_AFTER_SPREAD=1.2
MIN_STOP_DISTANCE_POINTS=0
MIN_TP_DISTANCE_POINTS=0
REQUIRE_ELIGIBLE_SIGNAL_FOR_EXECUTION=true
ALLOW_WATCHLIST_PLAN_PREVIEW=true
CHECK_MARGIN_REQUIREMENT=true

# Paper trading is simulation only. It must not send real MT5 orders.
PAPER_TRADING_ENABLED=true

# false allows WATCHLIST preview simulation for learning.
PAPER_TRADE_ELIGIBLE_ONLY=false

# WATCHLIST simulation helps learn whether watchlist signals were too strict.
PAPER_INCLUDE_WATCHLIST=true

PAPER_JOURNAL_PATH=data/logs/paper_trades.csv
PAPER_EVENTS_PATH=data/logs/paper_trade_events.jsonl
PAPER_OPEN_TRADES_SNAPSHOT_PATH=data/live/paper_trades_open_latest.json
PAPER_EXECUTION_OUTPUT_PATH=data/live/paper_execution_latest.json

# Closed trades CSV stores completed paper trades.
PAPER_CLOSED_TRADES_PATH=data/logs/paper_trades_closed.csv

# Status report stores current open/closed/floating paper state.
PAPER_STATUS_REPORT_PATH=data/live/paper_status_latest.json

# Performance summary stores aggregate paper performance.
PAPER_PERFORMANCE_REPORT_PATH=data/logs/paper_performance_summary.csv
PAPER_MAX_OPEN_TRADES=5
PAPER_MAX_OPEN_TRADES_PER_SYMBOL=1

# Plans must pass broker/cost validation before paper simulation; rejected signals are never simulated.
PAPER_USE_PRE_EXECUTION_VALIDATION=true

# Optional paper-only assumptions, in the account currency. Blank means unknown.
# Set commission to 0 only after verifying the connected MT5 account is commission-free.
# Slippage is an adverse stress assumption per side, in symbol points (not pips).
PAPER_COMMISSION_PER_LOT_ROUND_TRIP=
PAPER_SLIPPAGE_POINTS_PER_SIDE=

# Continuous paper bot loop settings. This is paper simulation only.
PAPER_BOT_LOOP_ENABLED=true
PAPER_BOT_POLL_SECONDS=30
PAPER_BOT_PRIMARY_TIMEFRAME=M5
PAPER_BOT_RUN_ON_NEW_CANDLE_ONLY=true

# 0 means run until manually stopped or until PAPER_BOT_STOP_AFTER_CLOSED_TRADES is reached.
PAPER_BOT_MAX_CYCLES=0
PAPER_BOT_STOP_AFTER_CLOSED_TRADES=50
PAPER_BOT_STATUS_EVERY_CYCLES=1
PAPER_BOT_HEARTBEAT_PATH=data/live/paper_bot_heartbeat.json
PAPER_BOT_RUN_LOG_PATH=data/logs/paper_bot_run.log
PAPER_BOT_ANALYSIS_REPORT_PATH=data/live/paper_analysis_latest.json
PAPER_BOT_ANALYSIS_MARKDOWN_PATH=data/logs/paper_analysis_report.md

# Optional paper-only experiment filters. Empty allowed lists mean no restriction.
PAPER_FILTERS_ENABLED=false
PAPER_ALLOWED_SYMBOLS=
PAPER_ALLOWED_TIMEFRAMES=
PAPER_ALLOWED_DIRECTIONS=
PAPER_MIN_SIGNAL_SCORE=0
PAPER_ALLOWED_SIGNAL_STATUSES=WATCHLIST,ELIGIBLE
PAPER_REQUIRE_COSTS_VALID=true
PAPER_REQUIRE_BROKER_CONSTRAINTS_VALID=true
PAPER_EXPERIMENT_NAME=baseline

LOG_LEVEL=INFO
